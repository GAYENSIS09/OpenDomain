# Normalise line endings in the repository, not in the working tree.
# Keeps `git status` clean when the same repo is used from Windows, Linux and
# macOS, which otherwise rewrites every file on checkout.
* text=auto eol=lf

# Windows-native binaries that must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch line endings or content of these.
*.pdf binary
*.png binary
*.jpg binary
